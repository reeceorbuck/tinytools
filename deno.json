{
  "name": "@tinytools/hono-tools",
  "description": "A lightweight enhancement layer for Hono web applications. Provides type-safe client functions, scoped styles, and enhanced JSX event handlers. Works with Deno, Bun, and Node.js.",
  "version": "0.1.43",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./jsx-runtime": "./jsx-runtime.ts",
    "./jsx-dev-runtime": "./jsx-dev-runtime.ts",
    "./build": "./build.ts",
    "./components": "./components/mod.ts",
    "./library": "./components/library/mod.ts",
    "./handlers": "./handlers/mod.ts"
  },
  "tasks": {
    "check": "deno check mod.ts build.ts components/mod.ts components/library/mod.ts handlers/mod.ts jsx-runtime.ts jsx-dev-runtime.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test --check --allow-env --allow-read --allow-write=./.test-build-output,./.test-client-src,./.test-lazy-rebuild,./.test-style-bundle-hash,./public,./.cache --allow-run tests/",
    "build:npm": "deno run -A scripts/build_npm.ts",
    "test:npm": "deno run -A scripts/npm_smoke.ts",
    "release": "deno run -A scripts/release.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "esbuild": "npm:esbuild@^0.28.2",
    "esbuild-wasm": "npm:esbuild-wasm@^0.28.2",
    "hono": "jsr:@hono/hono@^4.13.14",
    "linkedom": "npm:linkedom@0.18.14"
  },
  "compilerOptions": {
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "lib": [
      "esnext",
      "deno.ns",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ]
  },
  "publish": {
    "include": [
      "mod.ts",
      "titled.ts",
      "urlStyleVariables.ts",
      "jsx-runtime.ts",
      "jsx-dev-runtime.ts",
      "build.ts",
      "esbuildInit.ts",
      "handlerNamespace.ts",
      "signals.ts",
      "signalModules.ts",
      "importUsage.ts",
      "lifecycleBindings.ts",
      "lifecycleElement.ts",
      "lifecycleFallback.ts",
      "clientFunctions.ts",
      "clientTools.ts",
      "eventAttributes.ts",
      "scopedStyles.ts",
      "componentScope.ts",
      "honoFactory.tsx",
      "sendUpdates.tsx",
      "sse.ts",
      "startupPerformanceSummary.ts",
      "components/**/*.ts",
      "components/**/*.tsx",
      "handlers/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*.test.ts"
    ]
  }
}
