{
  "name": "@tinytools/hono-tools",
  "description": "A lightweight enhancement layer for Hono web applications. Provides type-safe client functions, scoped styles, and enhanced JSX event handlers. Works with Deno, Bun, and Node.js.",
  "version": "0.1.37",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./jsx-runtime": "./jsx-runtime.ts",
    "./jsx-dev-runtime": "./jsx-dev-runtime.ts",
    "./build": "./build.ts",
    "./components": "./components/mod.ts",
    "./handlers": "./handlers/mod.ts"
  },
  "tasks": {
    "check": "deno check mod.ts build.ts components/mod.ts handlers/mod.ts jsx-runtime.ts jsx-dev-runtime.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test --check --allow-env --allow-read --allow-write=./.test-build-output,./.test-client-src,./.test-lazy-rebuild,./.test-style-bundle-hash,./public,./.cache --allow-run tests/",
    "prepublish": "cd .. && deno task bump patch && deno task sync:npm-version && cd package && deno publish --allow-slow-types --allow-dirty",
    "npm:publish": "npm publish --access public"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "esbuild": "npm:esbuild@^0.28.1",
    "esbuild-wasm": "npm:esbuild-wasm@^0.28.1",
    "hono": "jsr:@hono/hono@^4.12.32",
    "linkedom": "npm:linkedom@0.18.12"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@tinytools/hono-tools",
    "lib": [
      "esnext",
      "deno.ns",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ]
  },
  "publish": {
    "include": [
      "mod.ts",
      "titled.ts",
      "urlStyleVariables.ts",
      "jsx-runtime.ts",
      "jsx-dev-runtime.ts",
      "build.ts",
      "esbuildInit.ts",
      "handlerNamespace.ts",
      "signals.ts",
      "clientFunctions.ts",
      "clientTools.ts",
      "eventAttributes.ts",
      "scopedStyles.ts",
      "componentScope.ts",
      "honoFactory.tsx",
      "sendUpdates.tsx",
      "sse.ts",
      "startupPerformanceSummary.ts",
      "components/**/*.ts",
      "components/**/*.tsx",
      "handlers/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*.test.ts"
    ]
  }
}
